<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>de.vptr.devkit</groupId>
    <artifactId>devkit-parent</artifactId>
    <version>0.10.0</version>
    <relativePath>.devkit/java/parent/pom.xml</relativePath>
  </parent>

  <groupId>de.vptr</groupId>
  <artifactId>nucleus-parent</artifactId>
  <version>${revision}</version>
  <packaging>pom</packaging>

  <name>nucleus</name>
  <description>A self-hosted pull-through artifact cache.</description>

  <!-- app inherits devkit's Quarkus parent, not this pom: it restates the licenses, the
       revision, coverage and compiler properties, the junit-jupiter test dependency and the
       Checkstyle configuration below, so a change to those here goes there too. -->
  <licenses>
    <license>
      <name>AGPL-3.0-or-later</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <!-- Placeholder to override with -Drevision= -->
    <revision>1.0.0-SNAPSHOT</revision>

    <!-- Project Settings -->
    <jacoco.check.lineMinimum>1.00</jacoco.check.lineMinimum>
    <jacoco.check.branchMinimum>1.00</jacoco.check.branchMinimum>
    <maven.compiler.release>25</maven.compiler.release>

    <!-- Other Dependencies & Plugins -->
    <junit.version>6.1.3</junit.version>
  </properties>

  <modules>
    <module>core</module>
    <module>app</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- For core. app takes JUnit from the Quarkus BOM: keep junit.version at the JUnit that
           BOM manages, and re-check it on every devkit bump. -->
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <pluginManagement>
      <plugins>
        <!-- One checkstyle-suppressions.xml at the root for every module, instead of the
             parent's one per module. Both executions, checkstyle and project, inherit it;
             app restates it. -->
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-checkstyle-plugin</artifactId>
          <configuration>
            <propertyExpansion>
              org.checkstyle.google.suppressionfilter.config=${maven.multiModuleProjectDirectory}/checkstyle-suppressions.xml</propertyExpansion>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
