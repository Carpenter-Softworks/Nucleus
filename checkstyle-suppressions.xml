<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN" "https://checkstyle.org/dtds/suppressions_1_2.dtd">
<suppressions>
    <!-- The threading-model fence names packages in string literals, and its fixture reaches
         Mutiny through a fully qualified name on purpose: the rule must catch exactly that. -->
    <suppress id="RegexpSinglelineJava.FullyQualifiedName"
        files="[/\\]de[/\\]vptr[/\\]nucleus[/\\]app[/\\](ThreadingModelTest|fixture[/\\]MutinyViaVarFixture)\.java$" />
</suppressions>
